generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              Int      @id @default(autoincrement()) @map("id")
  roleName        String   @map("role_name") @db.VarChar(100)
  roleCode        String   @unique @map("role_code") @db.VarChar(50)
  description     String?  @db.VarChar(255)
  requiresFaculty Boolean  @default(false) @map("requires_faculty")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users           User[]

  @@map("roles")
}

model Faculty {
  id           Int      @id @default(autoincrement()) @map("id")
  facultyName  String   @unique @map("faculty_name") @db.VarChar(150)
  facultyCode  String   @unique @map("faculty_code") @db.VarChar(50)
  description  String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users         User[]
  contributions Contribution[]

  @@map("faculties")
}

model User {
  id           Int      @id @default(autoincrement()) @map("id")
  roleId       Int      @map("role_id")
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String?  @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  facultyId    Int?     @map("faculty_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastLogin    DateTime? @map("last_login")

  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  faculty      Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  contributions Contribution[]

  @@index([facultyId])
  @@index([roleId])
  @@map("users")
}

model Contribution {
  id             Int      @id @default(autoincrement()) @map("id")
  userId         Int      @map("user_id")
  academicYearId Int      @map("academic_year_id")
  facultyId      Int      @map("faculty_id")
  title          String   @db.VarChar(255)
  contentMd      String?  @map("content_md") @db.Text
  status         String   @default("draft") @db.VarChar(50)
  submittedAt    DateTime? @map("submitted_at")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty        Faculty  @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@index([facultyId])
  @@index([academicYearId])
  @@index([status])
  @@index([submittedAt])
  @@index([facultyId, academicYearId, status, submittedAt])
  @@map("contributions")
}

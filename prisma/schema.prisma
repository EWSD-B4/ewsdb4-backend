generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
}

model Role {
  id               Int       @id @default(autoincrement())
  roleName         String    @map("role_name") @db.VarChar(100)
  roleCode         String    @unique @map("role_code") @db.VarChar(50)
  description      String?   @db.VarChar(255)
  requiresFaculty  Boolean   @default(false) @map("requires_faculty")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  users            User[]

  @@map("roles")
}

model Faculty {
  id              Int            @id @default(autoincrement())
  facultyName     String         @unique @map("faculty_name") @db.VarChar(150)
  facultyCode     String         @unique @map("faculty_code") @db.VarChar(50)
  description     String?        @db.VarChar(255)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  users           User[]
  contributions   Contribution[]

  @@map("faculties")
}

model User {
  id              Int                  @id @default(autoincrement())
  roleId          Int                  @map("role_id")
  email           String               @unique @db.VarChar(150)
  passwordHash    String               @map("password_hash") @db.VarChar(255)
  firstName       String?              @map("first_name") @db.VarChar(100)
  lastName        String?              @map("last_name") @db.VarChar(100)
  facultyId       Int?                 @map("faculty_id")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at")
  lastLogin       DateTime?            @map("last_login")

  role            Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  faculty         Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  contributions   Contribution[]
  comments        Comment[]
  submissionHistory SubmissionHistory[]
  sentEmails      EmailLog[]           @relation("SentEmails")
  receivedEmails  EmailLog[]           @relation("ReceivedEmails")
  notifications   Notification[]
  agreements      Agreement[]

  @@map("users")
}

model AcademicYear {
  id                Int            @id @default(autoincrement())
  yearName          String         @unique @map("year_name") @db.VarChar(20)
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime       @map("end_date") @db.Date
  closureDate       DateTime?      @map("closure_date")
  closureFinalDate  DateTime?      @map("closure_final_date")
  isCurrent         Boolean        @default(false) @map("is_current")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at")

  contributions     Contribution[]

  @@map("academic_years")
}

model Contribution {
  id              Int                  @id @default(autoincrement())
  userId          Int                  @map("user_id")
  academicYearId  Int                  @map("academic_year_id")
  facultyId       Int                  @map("faculty_id")
  title           String               @db.VarChar(255)
  contentMd       String?              @map("content_md") @db.Text
  status          String               @default("draft") @db.VarChar(50)
  submittedAt     DateTime?            @map("submitted_at")
  publishedAt     DateTime?            @map("published_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  faculty         Faculty              @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  files           ContributionFile[]
  comments        Comment[]
  submissionHistory SubmissionHistory[]
  agreements      Agreement[]

  @@map("contributions")
}

model ContributionFile {
  id              Int          @id @default(autoincrement())
  contributionId  Int          @map("contribution_id")
  fileType        String?      @map("file_type") @db.VarChar(50)
  originalName    String?      @map("original_name") @db.VarChar(255)
  storedName      String?      @map("stored_name") @db.VarChar(255)
  filePath        String?      @map("file_path") @db.VarChar(500)
  contentMd       String?      @map("content_md") @db.Text
  fileSize        BigInt?      @map("file_size")
  createdAt       DateTime     @default(now()) @map("created_at")
  uploadedAt      DateTime?    @map("uploaded_at")

  contribution    Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@map("contribution_files")
}

model Comment {
  id              Int          @id @default(autoincrement())
  contributionId  Int          @map("contribution_id")
  userId          Int          @map("user_id")
  content         String       @db.Text
  commentedAt     DateTime?    @map("commented_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  contribution    Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model SubmissionHistory {
  id              Int          @id @default(autoincrement())
  contributionId  Int          @map("contribution_id")
  userId          Int          @map("user_id")
  action          String       @db.VarChar(100)
  note            String?      @db.Text
  actionDate      DateTime     @map("action_date")
  createdAt       DateTime     @default(now()) @map("created_at")

  contribution    Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submission_history")
}

model EmailLog {
  id              Int       @id @default(autoincrement())
  senderId        Int?      @map("sender_id")
  recipientId     Int?      @map("recipient_id")
  type            String?   @db.VarChar(100)
  subject         String?   @db.VarChar(255)
  status          String?   @db.VarChar(50)
  body            String?   @db.Text
  errorMessage    String?   @map("error_message") @db.Text
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  sender          User?     @relation("SentEmails", fields: [senderId], references: [id], onDelete: SetNull)
  recipient       User?     @relation("ReceivedEmails", fields: [recipientId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

model Notification {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  type            String?   @db.VarChar(100)
  isRead          Boolean   @default(false) @map("is_read")
  title           String?   @db.VarChar(255)
  message         String?   @db.VarChar(500)
  data            Json?
  notificationAt  DateTime? @map("notification_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model TermsCondition {
  id              Int         @id @default(autoincrement())
  version         String      @unique @db.VarChar(50)
  content         String      @db.Text
  effectiveDate   DateTime    @map("effective_date")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")

  agreements      Agreement[]

  @@map("terms_conditions")
}

model Agreement {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  contributionId  Int            @map("contribution_id")
  termsId         Int            @map("terms_id")
  ipAddress       String?        @map("ip_address") @db.VarChar(45)
  agreeAt         DateTime       @map("agree_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contribution    Contribution   @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  terms           TermsCondition @relation(fields: [termsId], references: [id], onDelete: Restrict)

  @@map("agreements")
}
